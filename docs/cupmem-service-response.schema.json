{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CUPMemService common response v1 (structural validity, not factual correctness)",
  "type": "object",
  "required": ["schema_version", "operation", "status", "answers", "proposals", "warnings", "errors"],
  "properties": {
    "schema_version": {"const": "team-memory-service/v1"},
    "operation": {"type": "string"},
    "status": {"enum": ["ok", "partial", "insufficient", "invalid", "error", "needs_rebuild"]},
    "answers": {"type": "array", "items": {
      "type": "object", "required": ["text", "evidence"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/witness"}}
      }
    }},
    "proposals": {"type": "array", "items": {
      "type": "object", "required": ["id", "kind", "status", "previous", "incoming", "reviewer", "reason"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"enum": ["reconsider", "coexist", "conflict", "correction"]},
        "status": {"enum": ["pending", "approved", "rejected", "review_conflict"]},
        "previous": {"$ref": "#/$defs/witness"},
        "incoming": {"$ref": "#/$defs/witness"},
        "reviewer": {"type": "string"}, "reason": {"type": "string"}
      }
    }},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "object", "required": ["stage", "type"]}}
  },
  "$defs": {
    "witness": {
      "type": "object", "required": ["source_id", "location", "speaker", "quote", "start", "end"],
      "properties": {
        "source_id": {"type": "string"}, "location": {"type": "string"}, "speaker": {"type": "string"},
        "quote": {"type": "string", "minLength": 1},
        "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}
      }
    }
  }
}
